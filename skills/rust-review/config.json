{
  "base_branch": "main",
  "linter": {
    "rules": [
      "comment-greedy-wrap",
      "errors-doc",
      "symbol-order",
      "type-params-doc",
      "trait-params-doc"
    ],
    "double_check": [
      "comment-greedy-wrap",
      "errors-doc",
      "symbol-order",
      "type-params-doc",
      "trait-params-doc"
    ],
    "include_tests": false,
    "rule_doc_url": "https://raw.githubusercontent.com/y-scope/yscope-linter/main/docs/rules/{rule}.md"
  }
}
