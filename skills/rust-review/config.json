{
  "base_branch": "main",
  "linter": {
    "rules": ["comment-greedy-wrap", "errors-doc"],
    "double_check": ["comment-greedy-wrap", "errors-doc"],
    "include_tests": false,
    "rule_doc_url": "https://raw.githubusercontent.com/LinZhihao-723/yscope-rust-linter/main/docs/rules/{rule}.md"
  }
}
